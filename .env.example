# Copy this file to .env and fill in your own values.

# --- Generation ---
LLM_PROVIDER=anthropic          # "anthropic" or "none" (offline smoke-test stub)
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...

# --- Retrieval ---
# "tfidf_svd"            -- fully offline, no model download (see README)
# "sentence_transformers" -- real semantic embeddings, needs internet on first run
EMBEDDING_BACKEND=tfidf_svd
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_RERANKER=0
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
